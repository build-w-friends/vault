{
  "name": "@build-with-friends/vault-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vault": "src/cli.ts"
  },
  "exports": {
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "build:cli": "bun scripts/build-cli.ts",
    "cli": "bun src/cli.ts",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --env production --dry-run --outdir=.wrangler/deploy-dry-run",
    "install:cli": "bun run build:cli && bun scripts/install-cli.ts",
    "migrations:local": "wrangler d1 migrations apply DB --local",
    "migrations:production": "wrangler d1 migrations apply DB --remote --env production",
    "canary:oauth": "bun scripts/canary-oauth.ts",
    "canary:posthog": "bun scripts/canary-posthog.ts posthog",
    "canary:sentry": "bun scripts/canary-sentry.ts",
    "verify:providers": "bun scripts/verify-providers.ts",
    "recovery:rehearse": "bun scripts/recovery-rehearsal.ts",
    "master-keys:prepare-rotation": "bun scripts/rotate-master-key.ts prepare --yes",
    "acceptance": "bun scripts/acceptance.ts",
    "check": "tsc --noEmit && bun run deploy:dry-run",
    "test": "bun test src",
    "types": "wrangler types --env production --env-interface Env && (cd ../.. && bunx oxfmt poc/vault/worker-configuration.d.ts)",
    "types:check": "bun run types && git diff --exit-code -- worker-configuration.d.ts",
    "uninstall:cli": "bun scripts/uninstall-cli.ts",
    "acceptance:issuance": "bun scripts/issuance-acceptance.ts"
  },
  "dependencies": {
    "@clack/prompts": "latest",
    "@modelcontextprotocol/server": "latest",
    "aws4fetch": "latest",
    "hono": "latest",
    "libsodium-wrappers": "latest",
    "node-forge": "latest",
    "valibot": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "ts6.0",
    "@types/node-forge": "latest",
    "playwright": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
